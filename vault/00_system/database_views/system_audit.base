views:
  - type: table
    name: "Audit: Alle Module"
    filters:
      or:
        - file.folder == "20_ip_atoms"
        - file.folder == "10_expertise_map"
    order:
      - file.name
      - id
      - ebene_1
      - ebene_2
      - type
      - status
      - created
      - aliases
    sort:
      - property: ebene_1
        direction: ASC
      - property: ebene_2
        direction: ASC
  - type: table
    name: 🔍 Fehlende Aliases
    filters:
      and:
        - file.folder == "20_ip_atoms" || file.folder == "10_expertise_map"
        - "!aliases || aliases.length == 0"
    order:
      - file.name
      - id
      - status
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: ⚠️ ID nicht in Aliases
    filters:
      and:
        - file.folder == "20_ip_atoms" || file.folder == "10_expertise_map"
        - id
        - aliases
        - "!aliases.includes(id)"
    order:
      - file.name
      - id
      - aliases
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 📊 Type-Werte (Drift-Check)
    filters:
      or:
        - file.folder == "20_ip_atoms"
        - file.folder == "10_expertise_map"
    order:
      - type
      - file.name
      - id
    sort:
      - property: type
        direction: ASC
    group:
      - property: type
  - type: table
    name: 📊 Status-Verteilung
    filters:
      or:
        - file.folder == "20_ip_atoms"
        - file.folder == "10_expertise_map"
    order:
      - status
      - file.name
      - type
    sort:
      - property: status
        direction: ASC
    group:
      - property: status
  - type: table
    name: 📊 Parent Topics (Drift-Check)
    filters:
      or:
        - file.folder == "20_ip_atoms"
        - file.folder == "10_expertise_map"
    order:
      - ebene_1
      - file.name
      - ebene_2
    sort:
      - property: ebene_1
        direction: ASC
    group:
      - property: ebene_1
  - type: table
    name: 📊 Subtopics (Drift-Check)
    filters:
      and:
        - file.folder == "20_ip_atoms"
        - ebene_2
    order:
      - ebene_2
      - ebene_1
      - file.name
    sort:
      - property: ebene_2
        direction: ASC
    group:
      - property: ebene_2
  - type: table
    name: ⚠️ Fehlende Pflichtfelder (IP)
    filters:
      and:
        - file.folder == "20_ip_atoms"
        - "!id || !ebene_1 || !type || !status || !created || !description"
    order:
      - file.name
      - id
      - ebene_1
      - ebene_2
      - type
      - status
      - created
      - description
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: ⚠️ Fehlende Pflichtfelder (MOC)
    filters:
      and:
        - file.folder == "10_expertise_map"
        - "!id || !ebene_1 || !status || !description"
    order:
      - file.name
      - id
      - status
      - description
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: ⚠️ Summary zu kurz (<150)
    filters:
      and:
        - file.folder == "20_ip_atoms"
        - description
        - description.length < 150
    order:
      - file.name
      - description
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 📅 Älteste Entwürfe
    filters:
      and:
        - file.folder == "20_ip_atoms"
        - status == "entwurf"
    order:
      - created
      - file.name
      - ebene_1
      - ebene_2
    sort:
      - property: created
        direction: ASC
  - type: table
    name: 🔍 Dubletten-Check (Name)
    filters:
      or:
        - file.folder == "20_ip_atoms"
        - file.folder == "10_expertise_map"
    order:
      - file.name
      - file.folder
      - id
    sort:
      - property: file.name
        direction: ASC
