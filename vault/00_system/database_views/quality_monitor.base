views:
  - type: table
    name: Tabelle
    filters:
      and:
        - file.folder == "20_ip_atoms"
    order:
      - file.name
      - status
      - file.folder
      - id
      - type
      - ebene_1
      - ebene_2
      - created
      - description
    sort:
      - property: status
        direction: ASC
      - property: ebene_2
        direction: DESC
      - property: type
        direction: ASC
    columnSize:
      file.folder: 98
      note.type: 157
