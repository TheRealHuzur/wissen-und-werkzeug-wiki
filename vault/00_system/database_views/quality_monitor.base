views:
  - type: table
    name: Tabelle
    filters:
      and:
        - file.folder == "20_ip_atoms"
    order:
      - file.name
      - status
      - file.folder
      - id
      - area
      - type
      - intent
      - parent_topic
      - subtopic
      - created
      - summary
    sort:
      - property: status
        direction: ASC
      - property: subtopic
        direction: DESC
      - property: type
        direction: ASC
    columnSize:
      file.folder: 98
      note.type: 157
      note.intent: 126
