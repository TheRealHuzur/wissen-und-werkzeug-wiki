views:
  - type: table
    name: Tabelle
    filters:
      and:
        - parent_topic == "second_brain"
        - "!type.isEmpty()"
        - subtopic == "obsidian"
    order:
      - file.name
      - status
      - subtopic
    sort:
      - property: subtopic
        direction: ASC
    columnSize:
      file.name: 444
