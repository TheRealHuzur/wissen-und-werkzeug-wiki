views:
  - type: table
    name: Tabelle
    filters:
      and:
        - ebene_2 == "second-brain"
        - file.folder == "20_ip_atoms"
        - ebene_3 == "obsidian"
    order:
      - file.name
      - status
      - ebene_2
    sort:
      - property: ebene_2
        direction: ASC
    columnSize:
      file.name: 444
