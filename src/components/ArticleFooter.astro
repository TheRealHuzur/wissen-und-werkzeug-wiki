---
/**
 * Artikelfuss: Autorenblock und Angebotsverweis.
 *
 * Ersetzt den Markdown-Anhang, den scripts/export-wiki.mjs bis Paket 3 an jeden
 * Body gehaengt hat. Zentrale Pflege an einer Stelle, Standards-Wiki Abschnitt 8.
 *
 * Reihenfolge auf der fertigen Seite: Inhalt, Haeufige Fragen, Verwandte Artikel
 * (alle drei aus dem Notiz-Body), dann Autorenblock, dann Angebotsverweis.
 */
import { Image } from 'astro:assets';
import portrait from '../assets/patrick-rosskothen.png';

const { entry, id: routeId } = Astro.locals.starlightRoute;
const data = entry.data as Record<string, unknown>;

// Nur exportierte Artikel bekommen den Fuss. Ausgenommen sind die beiden
// handgepflegten Seiten index.md und index.mdx sowie die 404-Seite: Starlight
// baut sie aus einem virtuellen Eintrag, dessen filePath auf eine nicht
// vorhandene 404.md zeigt und die Pfadpruefung allein deshalb passieren wuerde.
const filePath = (typeof entry.filePath === 'string' ? entry.filePath : '').replace(/\\/g, '/');
const isArticle =
  filePath.startsWith('src/content/docs/') &&
  !/(^|\/)index\.mdx?$/.test(filePath) &&
  routeId !== '404';

// Das Datum der letzten Bearbeitung stand bis Paket 6 hier unten. Es steht
// jetzt als Meta-Zeile unter dem Lead am Kopf des Artikels, wie in der
// Designvorlage; die Bedingung dafuer ist unveraendert nach
// ArticleLead.astro gewandert.

// Angebotsverweis: Die H2 aus offer_heading bleibt unverlinkte Ueberleitung,
// der Link steht als Inline-Markdown mitten in offer_text. Muster in
// Verlinkungsmatrix, Abschnitt "Muster fuer den Verweis".
//
// Umgesetzt wird genau dieses eine Muster: ein Link, Ziel als Wurzelpfad mit
// Schraegstrich vorn und hinten. Bewusst keine allgemeine Markdown-Verarbeitung
// und keine neue Abhaengigkeit. Der Export laesst nur geprueften Werte durch,
// die Zerlegung hier ist die zweite Instanz derselben Regel.
const offerHeading = typeof data.offer_heading === 'string' ? data.offer_heading.trim() : '';
const offerText = typeof data.offer_text === 'string' ? data.offer_text.trim() : '';
const offerLinks = offerText.match(/\[[^\]]+\]\([^)]*\)/g) ?? [];
const offerParts =
  offerLinks.length === 1
    ? offerText.match(/^([\s\S]*?)\[([^\]]+)\]\((\/[^)\s]*\/)\)([\s\S]*)$/)
    : null;
const offer =
  offerHeading && offerParts
    ? {
        heading: offerHeading,
        before: offerParts[1],
        label: offerParts[2],
        href: offerParts[3],
        after: offerParts[4],
      }
    : null;
---

{
  isArticle && (
    <div class="artikelfuss">
      <div class="autorenblock">
        {/* Die Quelldatei ist 1536x1024 und damit querformatig, das Ziel ist
            hochformatig. Astro schneidet mittig zu: Der Kopf sitzt in der Mitte
            der Aufnahme und bleibt dabei vollstaendig im Bild. 208x260 Pixel
            fuer 104x130 Darstellung, also doppelte Aufloesung. */}
        <Image
          class="autorenfoto"
          src={portrait}
          alt="Patrick Roßkothen"
          width={208}
          height={260}
          fit="cover"
          position="center"
        />
        <div class="autorentext">
          <p class="w-label">Autor</p>
          <p>
            Geschrieben von Patrick Roßkothen, Organisationsberater und Dozent. Mehr zu mir und
            meiner Arbeit: <a href="/ueber-mich/">Über mich</a>
          </p>
        </div>
      </div>

      {offer && (
        <section class="angebotsverweis">
          <p class="w-label seminarlabel">Passendes Seminar</p>
          <h2>{offer.heading}</h2>
          <p>
            {offer.before}
            <a href={offer.href}>{offer.label}</a>
            {offer.after}
          </p>
        </section>
      )}
    </div>
  )
}

<style>
  /* Masse aus der Designvorlage: Trennlinie, darunter 36 Pixel Abstand. */
  .artikelfuss {
    margin-top: 2.5rem;
    padding-top: 36px;
    border-top: 1px solid var(--w-border);
  }

  /* Oben ausgerichtet, nicht mittig: Das Bild ist hoeher als der Textblock
     daneben, und die Beschriftung "Autor" soll mit seiner Oberkante beginnen. */
  .autorenblock {
    display: flex;
    align-items: flex-start;
    gap: 22px;
    flex-wrap: wrap;
  }

  .autorenfoto {
    width: 104px;
    height: 130px;
    border-radius: var(--w-radius-sm);
    flex: none;
    object-fit: cover;
  }

  .autorentext {
    flex: 1 1 18rem;
  }

  /* Die Beschriftung ausgenommen: Sie traegt die globale Klasse .w-label, und
     Astro haengt an gescopte Regeln ein eigenes Attribut. Ohne das :not()
     gewaenne diese Regel und die Beschriftung saehe aus wie Fliesstext. */
  .autorentext p:not(.w-label) {
    margin: 0;
    font-size: 1.0625rem; /* 17px */
    line-height: 1.6;
    max-width: 52ch;
    text-wrap: pretty;
    color: var(--w-text);
  }

  .autorentext .w-label {
    margin: 0 0 0.5rem;
  }

  .autorentext a {
    color: var(--w-accent);
  }

  /* Seit der Designueberarbeitung eine Karte mit Akzent-Oberkante. Der
     Standard aus Abschnitt 8 des Standards-Wiki -- Textblock statt Kasten,
     damit der Verweis nicht als Werbebanner gelesen wird -- ist damit
     abgeloest; die neue Form ist Teil der Vorlage. */
  .angebotsverweis {
    margin-top: 44px;
    padding: 26px 28px 28px;
    border: 1px solid var(--w-border);
    border-top: 3px solid var(--w-accent);
    border-radius: var(--w-radius);
    background: var(--w-card);
  }

  /* Dieselbe Beschriftung wie beim Autor, nur in Akzentfarbe statt gedaempft.
     So zeigt es die Vorlage. */
  .angebotsverweis .seminarlabel {
    margin: 0 0 10px;
    color: var(--w-accent);
  }

  .angebotsverweis h2 {
    margin: 0 0 10px;
    font-size: 1.5rem; /* 24px */
    line-height: 1.25;
  }

  .angebotsverweis p:not(.w-label) {
    margin: 0;
    font-size: 1.03125rem; /* 16.5px */
    line-height: 1.65;
    max-width: 60ch;
    text-wrap: pretty;
    color: var(--w-text);
  }

  .angebotsverweis a {
    color: var(--w-accent);
  }
</style>
