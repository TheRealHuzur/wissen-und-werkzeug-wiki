---
/**
 * Die drei Textlinks rechts in der Kopfzeile.
 *
 * Eingehaengt ueber Starlights ThemeSelect-Stelle, nicht ueber einen eigenen
 * Header-Override. Zwei Gruende: Diese Stelle liegt genau in der rechten
 * Gruppe der Kopfzeile, und Starlight rendert sie unterhalb von 50rem ein
 * zweites Mal im ausgeklappten Menue. Damit wandern die Links auf schmalen
 * Bildschirmen von selbst ins Menue, so wie die Vorlage es vorsieht. Ein
 * Header-Override muesste dafuer Starlights Rasterlayout mitkopieren.
 *
 * Der Farbmodus-Waehler, der hier urspruenglich stand, ist entfernt: Das Wiki
 * wird vorerst nur im hellen Modus gebaut, siehe ThemeProvider.astro.
 *
 * ACHTUNG, Ziele noch ungeprueft: Die Vorlage zeigt an dieser Stelle nur
 * Platzhalter. Die drei Adressen unten sind angenommen, nicht bestaetigt.
 */

const links = [
  { label: 'Seminare', href: 'https://wissen-und-werkzeug.de/seminare/' },
  { label: 'Beratung', href: 'https://wissen-und-werkzeug.de/beratung/' },
  { label: 'Werkzeuge', href: 'https://wissen-und-werkzeug.de/werkzeuge/' },
];
---

<nav class="kopfnavigation" aria-label="Angebote">
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
</nav>

<style>
  .kopfnavigation {
    display: flex;
    align-items: center;
    gap: 1.375rem; /* 22px */
  }

  .kopfnavigation a {
    font-weight: 600;
    font-size: 0.875rem; /* 14px */
    color: var(--w-head);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .kopfnavigation a:hover,
  .kopfnavigation a:focus-visible {
    color: var(--w-accent);
  }
</style>
