---
/**
 * Lead-Absatz am Kopf eines Artikels.
 *
 * Reihenfolge: Kopfzeile aus Brotkruemelpfad und Datum, H1, Lead, dann der
 * Inhalt. Diese Komponente traegt den Lead und wird von PageTitle.astro
 * hinter <Default /> gerendert.
 *
 * Der Lead kommt aus dem Frontmatter, nicht aus dem Body: Nur so steht er
 * ueber dem Inhaltsbereich und damit vor allem, was Starlight aus dem Markdown
 * baut. Der Export legt das Feld an, siehe extractLead() in
 * scripts/export-wiki.mjs.
 *
 * Die Lesezeit der Vorlage entfaellt, wie im Handoff vorgesehen. Das Datum
 * der letzten Bearbeitung stand bis zum 21.09.2026 als Meta-Zeile hier
 * unter dem Lead und steht jetzt in der Kopfzeile, siehe ArticleUpdated.astro.
 */

const { entry, id: routeId } = Astro.locals.starlightRoute;
const data = entry.data as Record<string, unknown>;

// Dieselbe Eingrenzung wie in ArticleFooter.astro: nur exportierte Artikel,
// nicht die beiden handgepflegten Startseiten und nicht die 404-Seite, die
// Starlight aus einem virtuellen Eintrag baut.
const filePath = (typeof entry.filePath === 'string' ? entry.filePath : '').replace(/\\/g, '/');
const isArticle =
  filePath.startsWith('src/content/docs/') &&
  !/(^|\/)index\.mdx?$/.test(filePath) &&
  routeId !== '404';

const lead = typeof data.lead === 'string' ? data.lead.trim() : '';
---

{
  isArticle && lead && (
    <div class="artikelkopf">
      <p class="artikel-lead">{lead}</p>
    </div>
  )
}

<style>
  .artikelkopf {
    margin-top: 0.875rem;
  }

  /* 18 Pixel bei 1.6 Zeilenhoehe: eine Stufe ueber dem Fliesstext (16) und
     unter der H3 (20). Die Vorlage sah 21 Pixel vor, das stand zu nah an der
     H2 (27) und liess den Lead wie eine zweite Ueberschrift wirken;
     Entscheidung vom 20.09.2026. text-wrap:pretty verhindert einzelne
     Woerter in der letzten Zeile. */
  .artikel-lead {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--w-text);
    text-wrap: pretty;
  }

  @media (max-width: 50em) {
    .artikel-lead {
      font-size: 1.0625rem; /* 17px */
    }
  }
</style>
