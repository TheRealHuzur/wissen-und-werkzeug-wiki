---
/**
 * Lead-Absatz und Meta-Zeile am Kopf eines Artikels.
 *
 * Reihenfolge der Designvorlage: Brotkruemelpfad, H1, Lead, Meta-Zeile,
 * Trennlinie, dann der Inhalt. Diese Komponente traegt die beiden mittleren
 * Stufen und wird von PageTitle.astro hinter <Default /> gerendert.
 *
 * Der Lead kommt aus dem Frontmatter, nicht aus dem Body: Nur so steht er
 * ueber dem Inhaltsbereich und damit vor allem, was Starlight aus dem Markdown
 * baut. Der Export legt das Feld an, siehe extractLead() in
 * scripts/export-wiki.mjs.
 *
 * Die Lesezeit der Vorlage entfaellt, wie im Handoff vorgesehen.
 */

const { entry, id: routeId } = Astro.locals.starlightRoute;
const data = entry.data as Record<string, unknown>;

// Dieselbe Eingrenzung wie in ArticleFooter.astro: nur exportierte Artikel,
// nicht die beiden handgepflegten Startseiten und nicht die 404-Seite, die
// Starlight aus einem virtuellen Eintrag baut.
const filePath = (typeof entry.filePath === 'string' ? entry.filePath : '').replace(/\\/g, '/');
const isArticle =
  filePath.startsWith('src/content/docs/') &&
  !/(^|\/)index\.mdx?$/.test(filePath) &&
  routeId !== '404';

const lead = typeof data.lead === 'string' ? data.lead.trim() : '';

const created = typeof data.created === 'string' ? data.created.trim() : '';
const updated = typeof data.updated === 'string' ? data.updated.trim() : '';

// Sichtbares Datum genau dann, wenn updated gesetzt und echt groesser als
// created ist. Bewusst schaerfer als die Bedingung fuer dateModified in den
// strukturierten Daten: Ein pauschal nachgetragenes updated wird so nicht
// sichtbar. Standards-Wiki Abschnitt 4, Entscheidung vom 28.08.2026.
// Beide Werte liegen als JJJJ-MM-TT vor, der Zeichenkettenvergleich ordnet
// in diesem Format korrekt.
const showUpdated = Boolean(created && updated && updated > created);
const updatedLabel = showUpdated
  ? new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(
      new Date(`${updated}T12:00:00Z`)
    )
  : '';
---

{
  isArticle && (lead || showUpdated) && (
    <div class="artikelkopf">
      {lead && <p class="artikel-lead">{lead}</p>}
      {showUpdated && (
        <div class="artikel-meta">
          <span>Zuletzt bearbeitet am {updatedLabel}</span>
        </div>
      )}
    </div>
  )
}

<style>
  .artikelkopf {
    margin-top: 0.875rem;
  }

  /* 21 Pixel bei 1.6 Zeilenhoehe, wie in der Vorlage. text-wrap:pretty
     verhindert einzelne Woerter in der letzten Zeile. */
  .artikel-lead {
    margin: 0;
    font-size: 1.3125rem;
    line-height: 1.6;
    color: var(--w-text);
    text-wrap: pretty;
  }

  /* Die Trennlinie gehoert an die Meta-Zeile, nicht an den Lead: Ohne Datum
     soll auch keine Linie stehen. */
  .artikel-meta {
    margin-top: 1.25rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--w-border);
    font-family: var(--sl-font-mono);
    font-size: 0.78125rem; /* 12.5px */
    color: var(--w-muted);
  }

  @media (max-width: 50em) {
    .artikel-lead {
      font-size: 1.125rem; /* 18px */
    }
  }
</style>
