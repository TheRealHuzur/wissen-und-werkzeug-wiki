---
/**
 * Fusszeile der Vorlage: Name des Wikis links, drei Verweise rechts.
 *
 * Steht in PageFrame.astro als letztes Kind von .main-frame und liegt damit
 * neben der Seitenleiste, nicht darunter. Genau so ist es in der Vorlage
 * aufgebaut.
 *
 * Nicht zu verwechseln mit Footer.astro: Das ist Starlights Artikelfuss und
 * traegt Autorenblock und Angebotsverweis am Ende eines Beitrags.
 *
 * Der Lizenzhinweis "Inhalte unter CC BY-SA 4.0" aus der Vorlage ist am
 * 20.09.2026 ersatzlos entfallen. Die Adressen von Impressum und Datenschutz
 * stammen aus der Designvorlage.
 */

const links = [
  { label: 'Zur Beratungsseite', href: 'https://wissen-und-werkzeug.de/' },
  { label: 'Impressum', href: 'https://wissen-und-werkzeug.de/impressum/' },
  { label: 'Datenschutz', href: 'https://wissen-und-werkzeug.de/datenschutz/' },
];
---

<footer class="seitenfuss">
  <div class="seitenfuss-inhalt">
    <span>Wissen &amp; Werkzeug Wiki</span>
    <div class="seitenfuss-links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </div>
</footer>

<style>
  /* position und z-index: Starlights Verzeichnis "Auf dieser Seite" ist fest
     positioniert, 100vh hoch und traegt links seine Trennlinie. Ohne eigene
     Ebene liefe diese Linie durch die Fusszeile hindurch; so deckt die
     Fusszeile sie mit ihrem Hintergrund ab und die Linie endet an ihrer
     Oberkante. */
  .seitenfuss {
    position: relative;
    z-index: 1;
    padding: 36px var(--sl-content-pad-x) 56px;
    border-top: 1px solid var(--w-border);
    background: var(--w-side);
  }

  /* Dieselbe Inhaltsbreite wie die Startseite der Vorlage. */
  .seitenfuss-inhalt {
    max-width: 1000px;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    font-size: 0.90625rem; /* 14.5px */
    color: var(--w-muted);
  }

  /* Linke Kante buendig mit der Artikelspalte. Dieselbe Rechnung wie fuer
     Startseite und Themenuebersicht in custom.css: Starlight teilt den freien
     Raum neben Artikelspalte und Verzeichnisspalte zur Haelfte auf, der Rand
     hier rechnet dieselbe Kante nach. Unterhalb von 72em zentriert Starlight
     nicht mehr, dort bleibt der Rand bei null. */
  @media (min-width: 72em) {
    .seitenfuss-inhalt {
      margin-inline-start: max(
        0px,
        calc(
          (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
            - var(--sl-content-pad-x)
        )
      );
    }
  }

  .seitenfuss-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .seitenfuss-links a {
    color: var(--w-accent);
    text-decoration: none;
  }

  .seitenfuss-links a:hover,
  .seitenfuss-links a:focus-visible {
    text-decoration: underline;
  }
</style>
