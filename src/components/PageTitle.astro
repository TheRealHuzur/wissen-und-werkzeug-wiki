---
/**
 * Starlight-Override fuer die Seitenueberschrift.
 *
 * Auf Artikelseiten wird die Kopfzeile vor <Default /> gerendert und steht
 * damit als erstes im Inhaltsbereich, oberhalb der H1: links der
 * Brotkruemelpfad, rechts das Datum der letzten Bearbeitung. Der Lead folgt
 * hinter der H1. Damit steht der Kopf eines Artikels in der Reihenfolge:
 * Pfad und Datum, H1, Lead. Die Designvorlage sah das Datum als Meta-Zeile
 * unter dem Lead vor; am 21.09.2026 in die Kopfzeile gewandert, siehe
 * ArticleUpdated.astro.
 *
 * Alles drei gehoert hierher und nicht in den Inhaltsbereich: Starlight
 * rendert Titel und Markdown in zwei getrennten Bereichen, zwischen die sich
 * nichts einschieben laesst.
 *
 * Auf der Startseite faellt dieser ganze Block weg. Ihre Ueberschrift steht im
 * Hero-Bereich, in Public Sans und mit eigenem Zuschnitt; Starlights Titel
 * daneben waere eine zweite H1 auf derselben Seite. Einen Brotkruemelpfad
 * braucht die Startseite ohnehin nicht, sie ist dessen erste Stufe.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleLead from './ArticleLead.astro';
import ArticleUpdated from './ArticleUpdated.astro';

const { entry } = Astro.locals.starlightRoute;
const filePath = (typeof entry.filePath === 'string' ? entry.filePath : '').replace(/\\/g, '/');
const istStartseite = /(^|\/)index\.mdx?$/.test(filePath);
---

{
  !istStartseite && (
    <>
      <div class="kopfzeile">
        <Breadcrumbs />
        <ArticleUpdated />
      </div>
      <Default />
      <ArticleLead />
    </>
  )
}

<style>
  /* Pfad links, Datum rechts, auf einer Grundlinie. Bricht der Pfad auf
     schmalen Bildschirmen um, rutscht das Datum in eine eigene Zeile darunter
     und bleibt dort rechts (margin-inline-start: auto in ArticleUpdated). */
  .kopfzeile {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
  }
</style>
