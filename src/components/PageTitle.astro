---
/**
 * Starlight-Override fuer die Seitenueberschrift.
 *
 * Auf Artikelseiten wird der Kopf vor <Default /> gerendert und steht damit
 * als erstes im Inhaltsbereich, oberhalb der H1: der Brotkruemelpfad. Hinter
 * der H1 folgen Lead und darunter das Datum der letzten Bearbeitung. Der Kopf
 * eines Artikels liest sich damit in der Reihenfolge: Pfad, H1, Lead, Datum,
 * dann der Inhalt.
 *
 * Das Datum stand vom 21. bis zum 22.09.2026 rechts in der Pfadzeile; es
 * zog dort den Blick vor die Ueberschrift. Jetzt steht es wieder unter dem
 * Lead wie in der Designvorlage, siehe ArticleUpdated.astro.
 *
 * Alles gehoert hierher und nicht in den Inhaltsbereich: Starlight rendert
 * Titel und Markdown in zwei getrennten Bereichen, zwischen die sich nichts
 * einschieben laesst.
 *
 * Auf der Startseite faellt dieser ganze Block weg. Ihre Ueberschrift steht im
 * Hero-Bereich, in Public Sans und mit eigenem Zuschnitt; Starlights Titel
 * daneben waere eine zweite H1 auf derselben Seite. Einen Brotkruemelpfad
 * braucht die Startseite ohnehin nicht, sie ist dessen erste Stufe.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleLead from './ArticleLead.astro';
import ArticleUpdated from './ArticleUpdated.astro';

const { entry } = Astro.locals.starlightRoute;
const filePath = (typeof entry.filePath === 'string' ? entry.filePath : '').replace(/\\/g, '/');
const istStartseite = /(^|\/)index\.mdx?$/.test(filePath);
---

{
  !istStartseite && (
    <>
      <Breadcrumbs />
      <Default />
      <ArticleLead />
      <ArticleUpdated />
    </>
  )
}
