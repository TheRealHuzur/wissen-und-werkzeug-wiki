---
/**
 * Der Kasten "Wer schreibt hier" in der rechten Haelfte des Hero-Bereichs.
 *
 * Der Kreis traegt das Portrait aus src/assets/patrick-rosskothen.png,
 * dasselbe Bild wie im Autorenblock am Fuss jedes Artikels. Die Vorlage sah
 * hier Initialen vor; am 20.09.2026 entschieden: Foto statt Initialen.
 */
import { Image } from 'astro:assets';
import portrait from '../assets/patrick-rosskothen.png';

interface Props {
  name: string;
  rolle: string;
  text: string;
  seminarText: string;
  seminarLabel: string;
  seminarHref: string;
}

const { name, rolle, text, seminarText, seminarLabel, seminarHref } = Astro.props;
---

<aside class="autorkasten">
  <p class="w-label">Wer schreibt hier</p>
  <div class="autorkasten-person">
    {/* Die Quelldatei ist 1536x1024, Astro schneidet mittig auf das Quadrat
        zu; der Kopf sitzt in der Mitte der Aufnahme. 120x120 fuer 60x60
        Darstellung, also doppelte Aufloesung. Leerer Alternativtext, weil der
        Name direkt daneben steht. */}
    <Image
      class="autorkasten-foto"
      src={portrait}
      alt=""
      width={120}
      height={120}
      fit="cover"
      position="center"
    />
    <span>
      <span class="autorkasten-name">{name}</span>
      <span class="autorkasten-rolle">{rolle}</span>
    </span>
  </div>
  <p class="autorkasten-text">{text}</p>
  <div class="autorkasten-seminar">
    <p class="w-label">Lieber im Seminar?</p>
    <p class="autorkasten-seminartext">{seminarText}</p>
    <a href={seminarHref}>{seminarLabel} →</a>
  </div>
</aside>

<style>
  .autorkasten {
    padding: 30px 32px 32px;
    border: 1px solid var(--w-border);
    border-radius: var(--w-radius-lg);
    background: var(--w-side);
  }

  /* Die Beschriftungen tragen die globale Klasse .w-label. Astro haengt an
     gescopte Regeln ein eigenes Attribut und hebt damit deren Spezifitaet;
     ohne eigene Regel bekaemen die Label die Abstaende der Absaetze. */
  .autorkasten .w-label {
    margin: 0 0 20px;
  }

  .autorkasten-person {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
  }

  /* Rund und in derselben Groesse wie der Initialenkreis der Vorlage. */
  .autorkasten-foto {
    flex: none;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
  }

  .autorkasten-name {
    display: block;
    font-weight: 600;
    font-size: 1.3125rem; /* 21px */
    line-height: 1.25;
    color: var(--w-head);
  }

  .autorkasten-rolle {
    display: block;
    font-size: 1rem;
    color: var(--w-muted);
  }

  .autorkasten-text {
    margin: 0 0 24px;
    font-size: 1.0625rem; /* 17px */
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* Eingesetzter Kasten auf Kartenfarbe, damit er sich von der ruhigen
     Flaeche des Autorkastens abhebt. */
  .autorkasten-seminar {
    padding: 20px 22px 22px;
    border: 1px solid var(--w-border);
    border-radius: var(--w-radius);
    background: var(--w-card);
  }

  .autorkasten-seminar .w-label {
    margin-bottom: 10px;
  }

  .autorkasten-seminartext {
    margin: 0 0 14px;
    font-size: 1.03125rem; /* 16.5px */
    line-height: 1.6;
  }

  .autorkasten-seminar a {
    font-size: 1.03125rem;
    color: var(--w-accent);
  }
</style>
